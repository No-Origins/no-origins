# admin.no-origins.com — Admin.md §8
#
# Local values come from `npx supabase start`, which prints them. The hosted ones are in the Supabase dashboard
# under Project Settings → API. Copy this to `.env.local` and fill it in; `.env*` is gitignored except this file.

# The project URL and the PUBLISHABLE (anon) key. Both are safe in a browser bundle — every table is
# deny-by-default with no anon policy (§8.3), so this key on its own can read nothing at all.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where "Open the showcase" points. The design system section links out until §13 step 5 folds it in.
NEXT_PUBLIC_DESIGN_URL=http://localhost:3001

# The service role key BYPASSES ROW LEVEL SECURITY. It is for the publish pipeline (§9) and for nothing else —
# never `NEXT_PUBLIC_`, never imported into a page or a client component. Not needed until step 8.
# SUPABASE_SERVICE_ROLE_KEY=
