# auth.no-origins.com — the login (Admin.md §8.4, step 5)
#
# Local values come from `npx supabase start`, which prints them. The hosted ones are in the Supabase dashboard
# under Project Settings → API, the same two the admin has. Copy this to `.env.local` and fill it in; `.env*` is
# gitignored except this file.

# The project URL and the PUBLISHABLE (anon) key. The login runs in the browser, so this app ships them there — the
# only app that will once the gates send everyone here. Every table is deny-by-default under RLS (Admin.md §8.3).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile's SITE key (public), for the challenge on the forms. Unset, there is no challenge and the forms
# send no token, which Supabase accepts while its CAPTCHA protection is off. Cloudflare's test key that always passes,
# for trying it locally: 1x00000000000000000000AA. The SECRET key never goes here: it is Supabase's, in its dashboard.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
