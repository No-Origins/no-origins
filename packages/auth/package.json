    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5"
