{
  "name": "@no-origins/auth",
  "version": "0.1.0",
  "description": "No Origins sign-in: one Supabase session for every app \u2014 the gate, the clients, the callback and the login card.",
  "type": "module",
  "private": true,
  "exports": {
    "./env": "./src/env.ts",
    "./cookies": "./src/cookies.ts",
    "./apps": "./src/apps.ts",
    "./safe-next": "./src/safe-next.ts",
    "./claims": "./src/claims.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./proxy": "./src/proxy.ts",
    "./routes": "./src/routes.ts",
    "./webauthn": "./src/webauthn.ts",
    "./challenge": "./src/challenge.tsx",
    "./second-factor": "./src/second-factor.tsx",
    "./cards": "./src/cards.tsx",
    "./login-card": "./src/login-card.tsx",
    "./sign-in": "./src/sign-in.tsx",
    "./permissions": "./src/permissions.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && node scripts/check-catalogue.mjs"
  },
  "dependencies": {
