{
  "ignoreFiles": ["src/css/tokens.css"],
  "rules": {
    "color-no-hex": true,
    "declaration-property-value-disallowed-list": {
      "/^(color|background|background-color|border-color|outline-color|fill|stroke|caret-color|accent-color)$/": [
        "/\\b(oklch|rgba?|hsla?)\\(/"
      ],
      "font-size": ["/^\\d+(\\.\\d+)?px$/"],
      "font": ["/(^|\\s)\\d+(\\.\\d+)?px\\//"],
      "border-radius": ["/^(?!(1|2)px$)\\d+px$/"]
    }
  }
}
