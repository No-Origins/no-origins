{
  "name": "@no-origins/ui",
  "version": "0.1.0",
  "description": "No Origins design system — tokens, atoms, molecules, organisms and templates: the glass, the blob, and the building blocks every block shares.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./canvas": "./src/templates/canvas/index.ts",
    "./css": "./src/css/index.css",
    "./index.css": "./src/css/index.css",
    "./tokens.css": "./src/css/tokens.css",
    "./typography.css": "./src/css/typography.css",
    "./tailwind.css": "./src/css/tailwind.css",
    "./glass.css": "./src/css/glass.css",
    "./motion.css": "./src/css/motion.css",
    "./components.css": "./src/css/components.css",
    "./registry": "./src/registry/index.ts",
    "./document": "./src/document/index.ts",
    "./icons": "./src/icons/index.ts",
    "./atoms.css": "./src/css/atoms.css",
    "./molecules.css": "./src/css/molecules.css",
    "./organisms.css": "./src/css/organisms.css",
    "./templates.css": "./src/css/templates.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./canvas": {
        "types": "./dist/templates/canvas/index.d.ts",
        "import": "./dist/templates/canvas/index.js"
      },
      "./css": "./src/css/index.css",
      "./index.css": "./src/css/index.css",
      "./tokens.css": "./src/css/tokens.css",
      "./typography.css": "./src/css/typography.css",
      "./tailwind.css": "./src/css/tailwind.css",
      "./glass.css": "./src/css/glass.css",
      "./motion.css": "./src/css/motion.css",
      "./components.css": "./src/css/components.css",
      "./registry": {
        "types": "./dist/registry/index.d.ts",
        "import": "./dist/registry/index.js"
      },
      "./document": {
        "types": "./dist/document/index.d.ts",
        "import": "./dist/document/index.js"
      },
      "./icons": {
        "types": "./dist/icons/index.d.ts",
        "import": "./dist/icons/index.js"
      },
      "./atoms.css": "./src/css/atoms.css",
      "./molecules.css": "./src/css/molecules.css",
      "./organisms.css": "./src/css/organisms.css",
      "./templates.css": "./src/css/templates.css"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && stylelint \"src/css/*.css\""
  },
  "peerDependencies": {
    "@phosphor-icons/react": ">=2.1",
    "@xyflow/react": ">=12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    },
    "@phosphor-icons/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^16.26.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
