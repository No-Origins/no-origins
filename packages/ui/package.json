{
  "name": "@no-origins/ui",
  "version": "0.0.1",
  "description": "No Origins design system — tokens, glass, motion, the blob, and the components every block shares.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./canvas": "./src/canvas/index.ts",
    "./css": "./src/css/index.css",
    "./index.css": "./src/css/index.css",
    "./tokens.css": "./src/css/tokens.css",
    "./typography.css": "./src/css/typography.css",
    "./tailwind.css": "./src/css/tailwind.css",
    "./glass.css": "./src/css/glass.css",
    "./motion.css": "./src/css/motion.css",
    "./components.css": "./src/css/components.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./canvas": {
        "types": "./dist/canvas/index.d.ts",
        "import": "./dist/canvas/index.js"
      },
      "./css": "./src/css/index.css",
      "./index.css": "./src/css/index.css",
      "./tokens.css": "./src/css/tokens.css",
      "./typography.css": "./src/css/typography.css",
      "./tailwind.css": "./src/css/tailwind.css",
      "./glass.css": "./src/css/glass.css",
      "./motion.css": "./src/css/motion.css",
      "./components.css": "./src/css/components.css"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@xyflow/react": ">=12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
